# Canonical public URL (production: https://tee-tribe.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mock catalog/orders until Supabase is connected (default true)
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_FREE_DELIVERY_FILS=20000
NEXT_PUBLIC_DELIVERY_FEE_FILS=1500

# Supabase (required when NEXT_PUBLIC_USE_MOCK=false)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout (restricted key with Checkout Sessions write). Leave unset for mock checkout.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend (optional)
# RESEND_API_KEY=
# EMAIL_FROM=Tee Tribe <orders@tee-tribe.com>
# EMAIL_REPLY_TO=alfred@redreach.ae
# QUOTE_NOTIFY_EMAIL=info@redreach.ae

# Central CRM sync (optional)
# CRM_SYNC_URL=https://YOUR_PROJECT.supabase.co/functions/v1/teetribe-order-sync
# CRM_SYNC_SECRET=

# Tayo (optional)
# ANTHROPIC_API_KEY=
# TAYO_RATE_LIMIT_PER_MIN=20
