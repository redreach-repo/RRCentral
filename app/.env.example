# Leave these unset (or keep placeholders) to run in LOCAL mode:
# data is stored in this browser's IndexedDB (database name: rrcentral_local).
# No cloud sync — use Settings → Download backup JSON regularly.
#
# Or connect at runtime: Settings → Data & storage → paste Supabase URL + anon key
# (no redeploy required). Run app/supabase-schema.sql in the Supabase SQL editor first.

# Optional build-time cloud backend (wins over Settings credentials):
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Tee Tribe Stripe checkout (local `npm run dev` / `npm run preview` only).
# Prefer a restricted key with Checkout Sessions write access over a secret key.
# Never prefix this with VITE_ — it must stay on the server.
STRIPE_SECRET_KEY=rk_test_...
# Optional: hosted Checkout function URL for GitHub Pages (Supabase Edge Function, etc.)
# VITE_CHECKOUT_API_URL=https://YOUR_PROJECT.functions.supabase.co/create-checkout-session
