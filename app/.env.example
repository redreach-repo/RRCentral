# Leave these unset (or keep placeholders) to run in LOCAL mode:
# data is stored in this browser's IndexedDB (database name: rrcentral_local).
# No cloud sync — use Settings → Download backup JSON regularly.

# To use a shared cloud backend, create a Supabase project, run supabase-schema.sql,
# enable Google OAuth, then set real values (not YOUR_PROJECT):
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
