# Leave these unset (or keep placeholders) to run in LOCAL mode:
# data is stored in this browser's IndexedDB (database name: rrcentral_local).
# No cloud sync — use Settings → Download backup JSON regularly.
#
# Or connect at runtime: Settings → Data & storage → paste Supabase URL + anon key
# (no redeploy required). Run app/supabase-schema.sql in the Supabase SQL editor first.

# Optional build-time cloud backend (wins over Settings credentials):
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
